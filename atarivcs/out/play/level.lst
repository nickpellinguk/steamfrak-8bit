------- FILE /home/user/steamfrak-8bit/atarivcs/levelc/game.asm LEVEL 2 PASS 3
      0  02fc					      include	"/home/user/steamfrak-8bit/atarivcs/levelc/game.asm"
      1  02fc							; Trogg control, after Steam Frak's TroggStanding / TroggFalling / TroggClimbing (js/trogg.js),
      2  02fc							; scaled from its 34-pixel Trogg to ours (13 rows): 1 Frak pixel = 13/34 row.
      3  02fc							;   standing: left/right walk a pixel every other frame (our pixels are twice Frak's); up climbs a ladder at the feet, or jumps (keeping
      4  02fc							;     the walking direction); down climbs onto a ladder below the platform; nothing underfoot falls
      5  02fc							;   falling: gravity to a terminal speed; up/down catches a ladder when not falling fast; landing
      6  02fc							;     too fast, or reaching the bottom of the screen, kills him (he restarts at the level's start)
      7  02fc							;   climbing: a row every other frame, sliding a pixel every fourth frame to the ladder's centre; left/right walks
      8  02fc							;     off onto a platform, or falls; climbing down onto a platform stands; the top steps off
      9  02fc							;   up/down are ignored after landing until released (Frak's updowndebounce)
     10  02fc							; Movement is tested against the level's movement maps (atarivcs/PLAN.md, "Movement maps"):
     11  02fc							;   PIdx (32 bands of 6 lines) -> byte offset into PPool (2 bytes: 16 cells of 8 px, x 16-143)
     12  02fc							;   LIdx (36 columns of 3 px on the P1 grid, x 19-126) -> byte offset into LPool (4 bytes: 32
     13  02fc							;     bands of 6 lines)
     14  02fc							;   FB: feet row -> platform band right under the feet, or $FF; Band3: n -> n / 3 (rows to
     15  02fc							;     6-line bands, and pixels to 3 px columns)
     16  02fc							;   LadL: the level's ladders (x, top row, bottom row), NLAD of them. The map says whether there is
     17  02fc							;     a ladder (to 6 lines); the list gives the one being climbed: its x (the climbing centre) and
     18  02fc							;     its exact ends (a Frak ladder stops above the platform below: down off it drops)
     19  02fc							; Included by levelc.py, which defines H, START_X, START_ROW and the data labels.
     20  02fc
     21  02fc		       00 a0	   TX	      =	$A0	; Trogg x (left edge, pixels)
     22  02fc		       00 a1	   TRow       =	$A1	; feet row (2-line rows)
     23  02fc		       00 a2	   TYF	      =	$A2	; feet row fraction (1/256 row)
     24  02fc		       00 a3	   VYL	      =	$A3	; vertical speed, rows/frame in 8.8, down positive
     25  02fc		       00 a4	   VYH	      =	$A4
     26  02fc		       00 a5	   XV	      =	$A5	; horizontal speed in the air: -1, 0, 1
     27  02fc		       00 a6	   State      =	$A6	; 0 standing, 1 in the air, 2 climbing
     28  02fc		       00 a7	   Facing     =	$A7	; REFP0 value: 0 right, 8 left
     29  02fc		       00 a8	   Tmp	      =	$A8
     30  02fc		       00 a9	   Tmp2       =	$A9
     31  02fc		       00 aa	   Joy	      =	$AA	; SWCHA this frame (player 0 in bits 7-4, 0 = pressed)
     32  02fc		       00 ab	   HMV	      =	$AB	; HMP0 for this frame's HMOVE
     33  02fc		       00 ac	   Frm	      =	$AC
     34  02fc		       00 ad	   Dead       =	$AD	; frames until the restart (0: alive)
     35  02fc		       00 ae	   XM	      =	$AE	; joystick x this frame
     36  02fc		       00 af	   Rows       =	$AF
     37  02fc		       00 b0	   UDDeb      =	$B0	; 1: ignore up/down until both are released
     38  02fc		       00 b1	   Repos      =	$B1	; 1: position P0 from TX this frame (start, restart)
     39  02fc		       00 b2	   LTarget    =	$B2	; the x of the ladder being climbed
     40  02fc		       00 b3	   LTop       =	$B3	; ... its top and bottom rows (feet)
     41  02fc		       00 b4	   LBot       =	$B4
     42  02fc		       00 b5	   LRowQ      =	$B5
     43  02fc		       00 b6	   YoLen      =	$B6	; yoyo: length (pixels) and fraction
     44  02fc		       00 b7	   YoF	      =	$B7
     45  02fc		       00 b8	   YoBack     =	$B8	; 1: coming back
     46  02fc		       00 b9	   YoDeb      =	$B9	; 1: fire must be released before the next throw
     47  02fc		       00 ba	   YoX	      =	$BA	; the yoyo's x (M0)
     48  02fc		       00 bb	   Collected  =	$BB	; a bit per item on the screen (ItBit): gone (gems and keys collected,
     49  02fc							; meanies yoyoed)
     50  02fc		       00 bc	   Mode       =	$BC	; 0: the front screen, 1: playing
     51  02fc		       00 bd	   FArm       =	$BD	; front screen: fire has been up (so a press starts)
     52  02fc		       00 d0	   TDig       =	$D0	; the timer: pointers to its four characters' glyphs (M, colon, S, S)
     53  02fc		       00 d8	   TFr	      =	$D8	; frames into the second
     54  02fc		       00 d9	   TSec       =	$D9	; seconds (BCD)
     55  02fc		       00 da	   TMin       =	$DA
     56  02fc							; MUSRAM ($DB-$E7, defined by levelc.py): the music driver's 13 bytes
     57  02fc							; RunX ($C0 on, defined by levelc.py): the line index of each run showing items, for the kernel
     58  02fc
     59  02fc		       00 00	   ST_STAND   =	0
     60  02fc		       00 01	   ST_AIR     =	1
     61  02fc		       00 02	   ST_CLIMB   =	2
     62  02fc		       00 03	   ST_YOYO    =	3
     63  02fc		       00 a6	   YOSPD      =	166	; 1.3 Frak px/tick: 0.65 of our pixels a frame
     64  02fc		       00 28	   YOMAX      =	40	; 80 Frak px
     65  02fc		       00 05	   GRAV       =	5	; 0.05 px/tick^2
     66  02fc		       00 7a	   JUMPV      =	122	; 1.25 px/tick
     67  02fc		       00 9d	   DIEV       =	157	; landing at 1.6 px/tick or faster kills
     68  02fc		       01 88	   TERMV      =	392	; 4 px/tick
     69  02fc		       00 62	   DROPV      =	98	; dropping off a ladder's bottom: 1 px/tick
     70  02fc		       00 7d	   GRABV      =	125	; ladders can be caught when falling no faster than 1.275 px/tick
